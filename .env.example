# Copy to .env in this repository. Never commit real values.
# Provided Anthropic key. Backend only.
ANTHROPIC_API_KEY=
# Set an available vision-capable model ID after checking the provided account.
ANTHROPIC_MODEL=

# Used only to create the initial administrator when the user table is empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Relative paths resolve from the repository root.
DATABASE_PATH=./data/app.sqlite3
SESSION_TTL_SECONDS=28800
AI_EXTRACT_TIMEOUT_SECONDS=30

# false for local HTTP; true for HTTPS.
COOKIE_SECURE=false

# Optional comma-separated browser origins. Defaults permit localhost and 127.0.0.1 on ports 8000 and 5173.
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
